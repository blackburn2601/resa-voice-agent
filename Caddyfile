# Caddy terminiert TLS und verteilt zwischen Vue-Build und API.
# Auf localhost stellt Caddy ein internes Zertifikat aus – die Web Speech API
# und getUserMedia brauchen einen sicheren Kontext, http reicht dafür nicht.

{$PUBLIC_HOST:localhost} {
	encode zstd gzip

	# Security-Header. CSP erlaubt bewusst nur eigene Quellen; die
	# Sprachausgabe kommt als Blob über den WebSocket, nicht per Fremd-URL.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' wss: ws:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /ws/* {
		reverse_proxy api:8000
	}

	# Vue-SPA: alles andere landet in der index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
