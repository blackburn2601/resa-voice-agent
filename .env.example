# ---------------------------------------------------------------------------
# Resa – Konfiguration. Kopieren nach .env und ausfüllen.
# ---------------------------------------------------------------------------

APP_ENV=dev
# Signiert die Session-Cookies. Erzeugen mit: openssl rand -hex 32
SECRET_KEY=bitte-aendern

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=resa
POSTGRES_PASSWORD=resa
POSTGRES_DB=resa
DATABASE_URL=postgresql+asyncpg://resa:resa@db:5432/resa

# --- Qdrant ----------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# Frei wählbar, muss mit QDRANT__SERVICE__API_KEY in docker-compose.yml übereinstimmen
QDRANT_API_KEY=resa-qdrant-key
QDRANT_COLLECTION=resa_knowledge

# --- Embeddings (Ollama) ---------------------------------------------------
# Lokal: die vorhandene Instanz im LAN.
# Auf dem VPS: `docker compose --profile local-embeddings up` starten und
# hier auf http://ollama:11434 umstellen.
OLLAMA_BASE_URL=http://192.168.178.180:11434
EMBEDDING_MODEL=bge-m3:latest
# Verifiziert gegen die Instanz. Änderung erzwingt eine Neuindizierung.
EMBEDDING_DIM=1024

# --- Anthropic -------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- ElevenLabs ------------------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Achtung: Im kostenlosen ElevenLabs-Tarif sind *Bibliotheks*-Stimmen über die
# API gesperrt (HTTP 402). Nutzbar sind dort nur einzelne vorinstallierte
# Stimmen, z. B. EXAVITQu4vr4xnSDxMaL (Bella, weiblich) oder
# pNInz6obpgDQGcFmaJgB (Adam, männlich). Für eine deutsche Stimme aus der
# Bibliothek ist ein kostenpflichtiger Tarif nötig.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- E-Mail für die Notfall-Alarmierung ------------------------------------
# Standard zeigt auf den Mailpit-Container aus docker-compose.yml
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=resa@musterhaus-verwaltung.de
SMTP_USE_TLS=false

# --- Frontend --------------------------------------------------------------
CORS_ORIGINS=https://localhost,http://localhost:5173
PUBLIC_HOST=localhost
